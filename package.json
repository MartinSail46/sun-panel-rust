{
  "name": "sun-panel-rust",
  "version": "1.0.0",
  "private": false,
  "description": "Sun-Panel Rust：基于 Rust、SQLite 与 Vue 的单用户导航面板",
  "keywords": [
    "Sun-Panel-Rust",
    "rust",
    "vue",
    "sqlite"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm run type-check && pnpm run build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "bootstrap": "pnpm install",
    "common:cleanup": "rimraf node_modules dist",
    "prepare": "husky",
    "test": "node --test tests/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-include=\"build/**\" tests/*.test.ts",
    "test:container": "node scripts/container-smoke.mjs"
  },
  "dependencies": {
    "@iconify/vue": "5.0.3",
    "@lucide/vue": "1.59.0",
    "@vueuse/core": "15.0.0",
    "axios": "1.20.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "pinia": "4.1.0",
    "reka-ui": "2.11.0",
    "tw-animate-css": "1.4.0",
    "vue": "3.5.44",
    "vue-draggable-plus": "0.6.1",
    "vue-router": "5.4.0",
    "vue-sonner": "2.0.9"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/sortablejs": "1.15.9",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "rimraf": "6.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vue-tsc": "3.3.13",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,mts,tsx,vue}": "eslint --fix"
  },
  "packageManager": "pnpm@9.4.0",
  "engines": {
    "node": "^24.22.0",
    "pnpm": "^9.4.0"
  },
  "type": "module"
}
